generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  NORMAL
  SUSCRIPTION
  SUPER
}

enum Difficulty {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum Body {
  ECTOMORFO
  MESOMORFO
  ENDOMORFO
}

enum MediaType {
  THUMBNAIL
  CONTENT
  YOUTUBE
}

model User {
  id                    Int                    @id @default(autoincrement())
  first_name            String
  last_name             String
  email                 String                 @unique
  phone_number          String
  password              String
  role                  Role
  body_type             Body?
  favorite_exercises    UserFavoriteExercise[]
  workout_logs          WorkoutLog[]
  routine_exercises     RoutineExercise[]
  exercises             Exercise[]
  routines              Routine[]
  muscles               Muscle[]
  birth_date            DateTime
  muscle_groups         MuscleGroups[]
  restrictions          Restriction[]
  user_restrictions     UserRestrictions[]
  exercise_restrictions ExerciseRestrictions[]
  exercise_muscles      ExerciseMuscles[]
  favorite_routines     UserFavoriteRoutine[]
  active_routine        UserActiveRoutine?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  status                Boolean                @default(true)
}

model Exercise {
  id                    Int                    @id @default(autoincrement())
  title                 String
  description           String
  instructions          String
  author_id             Int
  author                User                   @relation(fields: [author_id], references: [id], onDelete: Cascade)
  media                 Media[]
  exercise_restrictions ExerciseRestrictions[]
  exercise_muscles      ExerciseMuscles[]
  user_favorites        UserFavoriteExercise[]
  routines              RoutineExercise[]
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  status                Boolean                @default(true)
}

model Media {
  id          Int       @id @default(autoincrement())
  type        MediaType
  url         String    @db.VarChar(500)
  exercise_id Int?
  exercise    Exercise?  @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  routine_id  Int?
  routine     Routine?   @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model Routine {
  id             Int                   @id @default(autoincrement())
  title          String
  description    String?
  difficulty     Difficulty
  body_type      Body
  duration       String?
  frequency      String?
  author_id      Int
  author         User                 @relation(fields: [author_id], references: [id], onDelete: Cascade)
  media          Media[]
  exercises      RoutineExercise[]
  user_favorites UserFavoriteRoutine[]
  user_actives   UserActiveRoutine[]
  workout_logs   WorkoutLog[]
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt
  status         Boolean               @default(true)
}

model RoutineExercise {
  id          Int      @id @default(autoincrement())
  reps        Int
  sets        Int
  day_number  Int      @default(1)
  order       Int      @default(1)
  routine_id  Int
  routine     Routine  @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  exercise_id Int
  exercise    Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  author_id   Int
  author      User     @relation(fields: [author_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  status      Boolean  @default(true)
}

model Muscle {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String            @unique
  muscle_group_id  Int?
  muscle_group     MuscleGroups?     @relation(fields: [muscle_group_id], references: [id], onDelete: SetNull)
  muscle_exercises ExerciseMuscles[]
  author_id        Int?
  author           User?              @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  status           Boolean           @default(true)
}

model MuscleGroups {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @unique
  muscles     Muscle[]
  author_id   Int?
  author      User?     @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  status      Boolean  @default(true)
}

model Restriction {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  description           String                 @unique
  author_id             Int?                    @default(1)
  author                User?                   @relation(fields: [author_id], references: [id], onDelete: SetNull)
  user_restrictions     UserRestrictions[]
  exercise_restrictions ExerciseRestrictions[]
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  status                Boolean                @default(true)
}

model ExerciseRestrictions {
  id             Int         @id @default(autoincrement())
  exercise_id    Int
  exercise       Exercise    @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  restriction_id Int
  restriction    Restriction @relation(fields: [restriction_id], references: [id], onDelete: Cascade)
  author_id      Int
  author         User        @relation(fields: [author_id], references: [id], onDelete: Cascade)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  status         Boolean     @default(true)
}

model ExerciseMuscles {
  id          Int      @id @default(autoincrement())
  exercise_id Int
  exercise    Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade )
  muscle_id   Int
  muscle      Muscle   @relation(fields: [muscle_id], references: [id], onDelete: Cascade)
  author_id   Int
  author      User     @relation(fields: [author_id], references: [id], onDelete: Cascade)
}

model UserRestrictions {
  id             Int         @id @default(autoincrement())
  user_id        Int
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  restriction_id Int
  restriction    Restriction @relation(fields: [restriction_id], references: [id], onDelete: Cascade)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  status         Boolean     @default(true)
}

model UserFavoriteRoutine {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routine_id Int
  routine    Routine  @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([user_id, routine_id])
}

model UserFavoriteExercise {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise_id Int
  exercise    Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([user_id, exercise_id])
}

model UserActiveRoutine {
  id                 Int      @id @default(autoincrement())
  user_id            Int      @unique
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routine_id         Int
  routine            Routine  @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  start_date         DateTime @default(now())
  last_completed_day Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

// Historial inmutable de entrenamientos y biometría del usuario
model WorkoutLog {
  id         Int     @id @default(autoincrement())
  user_id    Int
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routine_id Int?
  routine    Routine? @relation(fields: [routine_id], references: [id], onDelete: SetNull)
  day_number Int // Bloque/Día relativo ejecutado (ej. Día 1, 2, 3)

  // Control de Tiempo
  started_at   DateTime // Hora exacta en que presionó "Iniciar" en el reloj
  completed_at DateTime @default(now()) // Hora exacta de finalización
  duration_sec Int? // Duración total efectiva en segundos

  // Biometría y Rendimiento (Exclusivo Wearables)
  calories       Int? // Calorías activas quemadas
  avg_heart_rate Int? // Frecuencia cardíaca promedio (BPM)
  max_heart_rate Int? // Frecuencia cardíaca máxima alcanzada (BPM)

  @@index([user_id, completed_at])
}
